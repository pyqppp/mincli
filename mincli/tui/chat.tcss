/* mincli ChatApp 样式（阶段 1b 骨架） */

Screen {
    layout: vertical;
}

Horizontal {
    height: 1fr;
    width: 1fr;
}

#sidebar {
    width: 34;
    min-width: 24;
    max-width: 60%;
    height: 1fr;
    border-right: solid $primary 30%;
    background: $surface;
}

/* 侧栏头部：标题 + 「全览/分栏」切换按钮压在同一行（比历史版本省 2 行高度），
   下面的 #tree-list 就用省出来的空间放对话树列表 */
#sidebar-header {
    height: 1;
    width: 1fr;
    background: $panel;
}

#sidebar-header #sidebar-title {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

#fullview-btn {
    width: auto;
    min-width: 6;
    height: 1;
    margin: 0 1 0 0;
    border: none;
    background: $surface;
    color: $primary;
}

/* 对话树列表：最多 3 行（加头部 1 行 = 最多 4 行），树更多时这一栏内部滚动 */
/* 不加分隔线：这一栏的行数上限是硬要求（1 行标题 + 最多 3 行树），
   多出来的第 5 行会破坏「最长 4 行」；标题行用 $panel 底色与列表区分 */
#tree-list {
    /* 高度由代码按行数设置：<=3 棵时 auto（收缩），>3 棵时固定 3 行（内部滚动）。
       不能用 max-height 代替——那会把超出的行挤成 0 高度而不是产生滚动区 */
    height: auto;
    width: 1fr;
    scrollbar-size-vertical: 1;
}

/* 顶部右侧的当前对话树徽标（编号 + 生成/完成状态） */
#tree-badge {
    dock: right;
    width: 22;
    height: 1;
    padding: 0 1;
    content-align: right middle;
    color: $primary;
    text-style: bold;
}

/* 建树 / 改能力向导 */
TreeWizardScreen {
    align: center middle;
    background: $background 60%;
}

#wizard-box {
    width: 78;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    border: round $accent 70%;
    background: $surface;
    padding: 0 1;
}

#wizard-title {
    height: 1;
    color: $primary;
    text-style: bold;
}

#wizard-note {
    height: auto;
    color: $text-muted;
}

#wizard-body {
    height: auto;
    max-height: 18;
    margin: 1 0;
}

.wizard-group {
    height: 1;
    color: $primary;
    text-style: bold;
    margin: 1 0 0 0;
}

.wizard-server {
    height: 1;
    color: $text-muted;
    margin: 1 0 0 1;
}

.wizard-hint {
    height: auto;
    color: $text-muted;
}

.wizard-tool {
    margin: 0 0 0 2;
}

#wizard-buttons {
    height: 3;
    align: right middle;
}

#wizard-buttons Button {
    margin: 0 0 0 2;
}

/* 全览模式：隐藏右侧回答区，节点树全宽显示（输入框保留） */
#chat-log.overview-hidden {
    display: none;
}

#sidebar.overview {
    width: 1fr;
    max-width: 100%;
}

#tree {
    height: 1fr;
}

#chat-log {
    height: 1fr;
    width: 1fr;
    padding: 0 2;
    border: none;
    background: $background;
    overflow-y: auto;
    scrollbar-gutter: stable;
    content-align: left top; /* 子内容始终从顶部对齐（与旧 Markdown 布局一致） */
}

/* 聊天区容器内的正文 Markdown 段与工具卡片：占满宽度，按内容自适应高度 */
#chat-log > Markdown,
#chat-log ToolCard {
    width: 100%;
}

/* 思考过程：灰色块引用（位于提问与回答之间，正文开始后折叠成一行） */
#chat-log MarkdownBlockQuote {
    color: $text-muted;
}

/* 代码块 / 工具调用块：橙色系（暖橙文字 + 橙色调底 + 橙色圆角边框） */
#chat-log MarkdownFence {
    color: #f2c694;
    background: $warning 15%;
    border: round $warning 40%;
    padding: 0 1;
}

/* 聊天区容器内的正文 Markdown 段：不自己滚动，按内容自适应高度 */
#chat-log > Markdown {
    height: auto;
    margin: 0 0 1 0;
}

/* 工具调用卡片：结构化控件（圆角边框 + 浅底 + 清晰层次），独立于正文 Markdown 流 */
#chat-log ToolCard {
    border: round $accent 45%;
    background: $primary 8%;
    color: $text;
    padding: 0 1;
    margin: 1 0 1 0;
    max-width: 100%;
    text-style: none;
}

/* 表格：列按终端宽度等分并自动换行（默认 grid-columns: auto 按内容撑宽，
   超宽表格会被横向截断，只能靠拉宽终端显示） */
#chat-log MarkdownTableContent {
    grid-columns: 1fr;
}
#chat-log MarkdownTableContent > .cell,
#chat-log MarkdownTableContent > .header {
    text-overflow: fold; /* 默认 ellipsis 会禁用换行（单行截断） */
}

/* 列表：防止 MarkdownList（expand=True + 行高 1fr）被拉伸成整屏高度，造成项目之间的大间隔 */
#chat-log MarkdownList,
#chat-log MarkdownBulletList,
#chat-log MarkdownOrderedList {
    height: auto;
}
#chat-log MarkdownOrderedList > Horizontal,
#chat-log MarkdownBulletList > Horizontal {
    height: auto;
}

ChatInput {
    height: 3;
    max-height: 8;
    margin: 1 0 0 0;
    padding: 0 1;
    border: tall $border-blurred;
    background: $surface;

    &:focus {
        border: tall $accent;
    }
}

/* 导入文件完整列表悬停弹窗：悬停状态条中段时显示在状态条上方固定位置（不跟随光标）。
   关键：layer 让弹窗在独立布局层内排列，显隐不影响主内容布局（避免整排被顶起）；
   设定 min-width 保证弹窗不至于过窄 */
#import-popup {
    layer: overlay;
    display: none;
    position: absolute;
    width: auto;
    min-width: 48;
    max-width: 75%;
    height: auto;
    max-height: 40%;
    padding: 0 1;
    border: round $accent 60%;
    background: $surface;
    color: $text;
    overflow-y: auto;
    scrollbar-size-vertical: 0;
}

#import-popup.visible {
    display: block;
}

/* 命令补全/提示弹窗（输入框上方，仅输入 "/" 开头命令时显示） */
#cmd-popup {
    display: none;
    height: auto;
    max-height: 45%;
    margin: 0 1;
    padding: 0 1;
    border: round $accent 60%;
    background: $surface;
    overflow-y: auto;
    scrollbar-size-vertical: 0;
}

#cmd-popup.visible {
    display: block;
}

#cmd-popup-body {
    height: auto;
    color: $text;
}

Footer {
    height: 1;
}

/* 输入栏下方状态条（三分栏，已并入原导入提示行，不再新增独立模块）：
   左=缓存命中率+余额，中=已导入文件提示（悬停查看完整列表），右=下次输入估算。
   注意：border-top 占 1 行，内容区需留 1 行（height: 2），否则文字会被挤出与 Footer 重叠 */
#usage-bar {
    height: 2;
    width: 1fr;
    background: $surface;
    border-top: solid $border-blurred;
}

#usage-left {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

/* 中段：占满左右两段之间的空位，文字水平居中；有导入文件时才显示内容。
   单行不换行（防止长文本把状态条撑成两行），超出部分省略号提示（完整列表可悬停查看） */
#usage-center {
    width: 1fr;
    padding: 0 1;
    color: $text-muted;
    content-align: center middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

#usage-right {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

/* 确认对话框 */
ConfirmScreen {
    align: center middle;
    background: $background 70%;
}

/* 关键：Vertical 默认 height:1fr，不显式覆盖会被拉伸到整个屏幕高度 */
#confirm-box {
    width: 60;
    max-width: 80%;
    height: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
    layout: vertical;
}

#confirm-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#confirm-text {
    max-height: 3;
    overflow-y: auto;
    margin-bottom: 1;
    color: $text;
}

#confirm-buttons {
    height: 3;
    align: center middle;
    & Button {
        margin: 0 2;
        /* 去掉按钮边框压缩高度：文字 1 行 + line-pad 1 上下各 1 行 = 3 行，
           正好放进 height: 3 的按钮行（line-pad 最小值为 1，不能设为 0） */
        border: none;
    }
    & Button#confirm-no {
        background: $panel; /* “否”无边框后与盒子底色相同，给个浅底区分 */
    }
}
