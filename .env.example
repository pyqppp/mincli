# mincli 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# DeepSeek API Key（必填）
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MCP server 配置文件路径（可选，默认 ~/.mincli/mcp_servers.json）
# 格式见 readme「MCP 接入」章节
# MINCLI_MCP_CONFIG=

# execute_command 工具的超时上限（秒，可选，默认 1800）
# 渲染/构建等长任务可放宽；卡住时在 TUI 按 Esc（或 Ctrl+C）打断并终止命令
# MINCLI_EXEC_MAX_TIMEOUT=1800
